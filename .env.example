NODE_ENV=development
PORT=3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=shipment

# RabbitMQ Configuration (Single Topic Exchange)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=root
RABBITMQ_URL=amqp://user:root@rabbitmq:5672
RABBITMQ_TOPIC_EXCHANGE=app.topic.exchange
RABBITMQ_NOTIFICATION_QUEUE=notification_queue

# SMTP Configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Shipment <shipment@gmail.com>"
